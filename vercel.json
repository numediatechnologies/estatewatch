{
  "version": 2,
  "builds": [
    {
      "src": "server/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "node_modules/pdfjs-dist/legacy/build/pdf.worker.mjs"
        ]
      }
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server/index.ts"
    },
    {
      "src": "/(assets/.*|robots\\.txt|sitemap\\.xml|site\\.webmanifest|favicon\\.ico|favicon-128\\.png)",
      "dest": "/dist/$1"
    },
    {
      "src": "/deceased-estate-alerts/([^/]+)/?",
      "dest": "/dist/deceased-estate-alerts/$1/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/dist/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/ingest",
      "schedule": "45 4 * * 1-6"
    },
    {
      "path": "/api/cron/ingest",
      "schedule": "45 11 * * 1-6"
    }
  ]
}
