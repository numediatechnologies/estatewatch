# EstateWatch Configuration
VITE_APP_TITLE=EstateWatch

# Database
DATABASE_URL=postgresql://user:password@host:port/database
POSTGRES_URL=postgresql://user:password@host:port/database

# Firecrawl API (for Gazette scraping)
FIRECRAWL_API_KEY=fc-your-api-key-here
ADMIN_API_TOKEN=replace-with-a-long-random-token
AUTH_SESSION_SECRET=replace-with-a-separate-random-session-secret
IDENTITY_MATCH_SECRET=replace-with-a-separate-random-hmac-secret
ADMIN_EMAIL=support@marketdirect.co.za
APP_URL=http://localhost:3000
CRON_SECRET=replace-with-a-separate-long-random-token
NEON_AUTH_BASE_URL=https://your-neon-auth-url/auth
VITE_NEON_AUTH_URL=https://your-neon-auth-url/auth

# Email delivery
RESEND_API_KEY=re_your-api-key-here
RESEND_FROM=EstateWatch <alerts@tenders.marketdirect.co.za>
ESTATEWATCH_ALERT_EMAIL=authorized-test-recipient@example.com

# MarketDirect leads CRM and follow-up queue
LEADS_CONTACT_WEBHOOK_URL=https://leads.marketdirect.co.za/api/ingest/marketdirect-contact
LEADS_CONTACT_WEBHOOK_KEY=replace-with-shared-contact-webhook-key
CORS_ALLOWED_ORIGINS=https://estatewatch.marketdirect.co.za,http://localhost:3000,http://127.0.0.1:3000

# Optional secondary SMS delivery (email remains mandatory/default)
CLICKATELL_API_KEY=replace-with-clickatell-api-key

# Development only; never enable these in production
VITE_ENABLE_DEMO_DATA=false
VITE_ENABLE_DEMO_LOGIN=false
