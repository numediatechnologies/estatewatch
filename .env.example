# EstateWatch Configuration
VITE_APP_TITLE=EstateWatch

# Database
DATABASE_URL=postgresql://user:password@host:port/database
POSTGRES_URL=postgresql://user:password@host:port/database

# Firecrawl API (for Gazette scraping)
FIRECRAWL_API_KEY=fc-your-api-key-here
ADMIN_API_TOKEN=replace-with-a-long-random-token
APP_URL=http://localhost:3000

# Email Configuration (optional - falls back to Ethereal test account)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-password
SMTP_FROM=EstateWatch Alerts <alerts@estatewatch.co.za>
