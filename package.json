{
  "name": "estatewatch",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run server\" \"vite --host 0.0.0.0 --port 3000\"",
    "server": "tsx server/index.ts",
    "db:init": "tsx server/initDb.ts",
    "build": "tsc && vite build && tsx scripts/generate-seo-pages.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:firecrawl:live": "tsx scripts/test-firecrawl-live.ts",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "fetch-gazettes": "tsx scripts/firecrawl-fetch.ts",
    "seo:generate": "tsx scripts/generate-sitemap.ts"
  },
  "dependencies": {
    "@google-cloud/documentai": "^9.6.2",
    "@napi-rs/canvas": "1.0.5",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "clsx": "^2.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firecrawl": "4.32.0",
    "lucide-react": "^0.344.0",
    "motion": "^11.11.17",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^6.18.1",
    "tailwind-merge": "^2.2.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.3",
    "vite": "6.4.3",
    "zeptomail": "^8.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.2.1",
    "concurrently": "^9.1.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "vitest": "^4.1.10"
  }
}
